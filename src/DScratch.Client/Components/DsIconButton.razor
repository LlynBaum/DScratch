<button
    class="icon-button @(IsActive ? "active" : "")"
    @onmousedown:preventDefault="@PreventDefault"
    @onclick="OnClick"
    title="@Title"
    disabled="@Disabled"
    @attributes="AdditionalAttributes">
    @if (Icon.HasValue)
    {
        <DsIcon Icon="Icon.Value" />
    }
    else
    {
        @ChildContent
    }
</button>
