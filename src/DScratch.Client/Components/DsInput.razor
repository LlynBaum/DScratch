@namespace DScratch.Client.Components
@inherits Microsoft.AspNetCore.Components.Forms.InputBase<string>

<input
    type="text"
    @oninput="EventCallback.Factory.CreateBinder(this, value => CurrentValueAsString = value, CurrentValueAsString ?? string.Empty)"
    @attributes="AdditionalAttributes"
    class="@CombinedCssClass"
    value="@CurrentValueAsString"
/>