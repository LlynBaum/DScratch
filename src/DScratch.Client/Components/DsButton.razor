<button
    type="@Type"
    class="@CssClass"
    disabled="@Disabled"
    style="@Style"
    @onclick="OnClick"
    @attributes="AdditionalAttributes">
    @if (Icon.HasValue)
    {
        <DsIcon Icon="Icon.Value" />
    }
    @if (ChildContent != null)
    {
        <span>@ChildContent</span>
    }
</button>
