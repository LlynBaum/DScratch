<button
    type="button"
    @onclick="OnClick"
    @onmousedown:preventDefault="@PreventDefault"
    @attributes="AdditionalAttributes"
    disabled="@Disabled"
    class="@CssClass">
    @if (Icon.HasValue)
    {
        <DsIcon Icon="Icon.Value" />
    }
    @if (ChildContent != null)
    {
        <span>@ChildContent</span>
    }
</button>
