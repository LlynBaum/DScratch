@using DScratch.Client.Components
@using DScratch.Client.Components.MenuBar
@using DScratch.Interactions.CommandHandlers
@rendermode InteractiveWebAssembly

<nav class="menu">
    <DsIconButton OnClick="@BoldAsync" IsActive="@viewModel.IsBoldActive" Icon="EditorIcon.Bold" PreventDefault Title="Bold" />
    <DsIconButton OnClick="@ItalicAsync" IsActive="@viewModel.IsItalicActive" Icon="EditorIcon.Italic" PreventDefault Title="Italic" />
    
    <ColorPicker @bind-Value="viewModel.ActiveColor" OnClear="ClearColorAsync" @bind-Value:after="OnColorChangeAsync" />
    
    <MenuDivider />
    
    <DsIconButton OnClick="@ParagraphAsync" Icon="EditorIcon.Paragraph" PreventDefault Title="Paragraph" />
    <DsIconButton OnClick="@(async () => await HeadingAsync(BlockNodeType.Heading1))" Icon="EditorIcon.Heading1" PreventDefault Title="Heading 1" />
    <DsIconButton OnClick="@(async () => await HeadingAsync(BlockNodeType.Heading2))" Icon="EditorIcon.Heading2" PreventDefault Title="Heading 2" />
    <DsIconButton OnClick="@(async () => await HeadingAsync(BlockNodeType.Heading3))" Icon="EditorIcon.Heading3" PreventDefault Title="Heading 3" />
    <DsIconButton OnClick="@(async () => await HeadingAsync(BlockNodeType.Heading4))" Icon="EditorIcon.Heading4" PreventDefault Title="Heading 4" />
    <DsIconButton OnClick="@(async () => await HeadingAsync(BlockNodeType.Heading5))" Icon="EditorIcon.Heading5" PreventDefault Title="Heading 5" />
    <DsIconButton OnClick="@(async () => await HeadingAsync(BlockNodeType.Heading6))" Icon="EditorIcon.Heading6" PreventDefault Title="Heading 6" />
    
    <MenuDivider />
    
    <DsIconButton id="add-link" Icon="EditorIcon.Link" PreventDefault Title="Add Link" />
</nav>

<DsPopover Id="add-link-popover" popover="hint">
    <DsInput type="url" placeholder="https://example.com" @bind-Value="linkUrl" @bind-Value:event="oninput" @onkeydown="HandleLinkKeyDown" />
    <DsButton Variant="DsButtonVariant.Primary" OnClick="@SubmitLinkAsync">Add Link</DsButton>
</DsPopover>

<DsPopover Id="link-settings-popover" popover="hint">
    <DsIconButton OnClick="@RemoveLinkAsync" Icon="EditorIcon.LinkOff" Title="Remove Link" />
</DsPopover>