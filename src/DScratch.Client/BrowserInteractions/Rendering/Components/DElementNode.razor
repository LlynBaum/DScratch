@DynamicHtml(BuildChildren())

@code {

    private RenderFragment DynamicHtml(RenderFragment content) => builder =>
    {
        builder.OpenElement(0, ElementNode.Tag);
        builder.AddAttribute(1, "data-dnode-id", ElementNode.Id);
        builder.AddContent(2, content);
        builder.CloseElement();
    };

    private RenderFragment BuildChildren()
    {
        return @<text>
                    @foreach (var child in ElementNode.ChildNodes!)
                    {
                        if (child.HasChildNodes)
                        {
                            <DElementNode ElementNode="child" />
                        }
                        else
                        {
                            <DTextNode TextElement="child" />
                        }
                    }
                </text>;
    }

}