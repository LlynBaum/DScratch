<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
        <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.8"/>
    </ItemGroup>

    <ItemGroup>
      <Content Update="Scripts/editor.js">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\tools\DScratch.TreeVisualizers\DScratch.TreeVisualizers.csproj" />
      <ProjectReference Include="..\DScratch\DScratch.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Track TypeScript sources for incremental builds -->
        <TypeScriptFiles Include="BrowserInteractions/Scripts/**/*.ts;BrowserInteractions/Scripts/package.json" />
    </ItemGroup>

    <!-- Run before static web asset discovery and publish pipelines -->
    <Target Name="BundleJS"
            BeforeTargets="ResolveStaticWebAssetsInputs;ResolveProjectStaticWebAssets;BeforeBuild;BeforePublish"
            Inputs="@(TypeScriptFiles)"
            Outputs="wwwroot/js/editor.bundle.js">
        <Exec Command="npm install" WorkingDirectory="BrowserInteractions/Scripts" />
        <Exec Command="npx esbuild editor.ts --bundle --outfile=../../wwwroot/js/editor.bundle.js" WorkingDirectory="BrowserInteractions/Scripts" />
    </Target>

</Project>
