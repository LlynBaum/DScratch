<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
        <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
        
        <FrontendRootPath>$(MSBuildProjectDirectory)/BrowserInteractions/Scripts/</FrontendRootPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.8"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\tools\DScratch.TreeVisualizers\DScratch.TreeVisualizers.csproj" />
      <ProjectReference Include="..\DScratch\DScratch.csproj" />
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="Swallow.MSBuild.Node" Version="0.3.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>build</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    
    <ItemGroup>
      <_ContentIncludedByDefault Remove="Pages\Editor\Components\Debugging\DebugPanel.razor" />
      <_ContentIncludedByDefault Remove="Pages\Editor\Components\Debugging\DebugSelection.razor" />
      <_ContentIncludedByDefault Remove="Pages\Editor\Components\Debugging\DebugTransaction.razor" />
      <_ContentIncludedByDefault Remove="Pages\Editor\Components\Debugging\DebugTreePanel.razor" />
    </ItemGroup>
    
    <ItemGroup>
      <AdditionalFiles Include="Pages\Editor\Debugging\DebugPanel.razor" />
      <AdditionalFiles Include="Pages\Editor\Debugging\DebugSelection.razor" />
      <AdditionalFiles Include="Pages\Editor\Debugging\DebugTransaction.razor" />
      <AdditionalFiles Include="Pages\Editor\Debugging\DebugTreePanel.razor" />
    </ItemGroup>
    
    <ItemGroup>
      <None Remove="BrowserInteractions\Scripts\tests\vitest.config.ts" />
      <None Remove="BrowserInteractions\Scripts\tests\transactions\nodeHelper.test.ts" />
      <None Remove="BrowserInteractions\Scripts\tests\transactions\selection.test.ts" />
      <None Remove="BrowserInteractions\Scripts\tests\nodeHelper.test.ts" />
      <None Remove="BrowserInteractions\Scripts\tests\selection.test.ts" />
      <None Remove="BrowserInteractions\Scripts\tests\transactions\pagingMock.ts" />
    </ItemGroup>

</Project>
