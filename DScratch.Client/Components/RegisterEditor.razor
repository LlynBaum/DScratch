@using System.Runtime.InteropServices
@using DScratch.Client.Scripts

@rendermode InteractiveWebAssembly
@inject InputEventHelper InputEventHelper
@inject IJSRuntime JsRuntime
@inject IDScratchService DScratchService 

@code {

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && RuntimeInformation.ProcessArchitecture == Architecture.Wasm)
        {
            var dotNetRef = DotNetObjectReference.Create(InputEventHelper);
            await JsRuntime.InvokeVoidAsync(ScriptConstants.EditorInitialize, dotNetRef);
            await JsRuntime.InvokeVoidAsync(ScriptConstants.ApplyTransactionJs, DScratchService.InitialTransaction());
        }
    }

}