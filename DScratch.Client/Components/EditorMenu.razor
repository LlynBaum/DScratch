@using DScratch.Client.BrowserInteractions.CommandHandlers
@rendermode InteractiveWebAssembly

<div class="menu">
    <button @onclick="BoldAsync">Bold</button>
    <button @onclick="ItalicAsync">Italic</button>
    <button @onclick="CodeAsync">Code</button>
    
    <div>|</div>
    
    <button @onclick="BlockquoteAsync">Blockquote</button>
    
    <div>|</div>
    
    <button @onclick="ParagraphAsync">Paragraph</button>
    <button @onclick="async () => await HeadingAsync(BlockType.Heading1)">Heading 1</button>
    <button @onclick="async () => await HeadingAsync(BlockType.Heading2)">Heading 2</button>
    <button @onclick="async () => await HeadingAsync(BlockType.Heading3)">Heading 3</button>
    <button @onclick="async () => await HeadingAsync(BlockType.Heading4)">Heading 4</button>
    <button @onclick="async () => await HeadingAsync(BlockType.Heading5)">Heading 5</button>
    <button @onclick="async () => await HeadingAsync(BlockType.Heading6)">Heading 6</button>
    <button @onclick="CodeBlockAsync">Code Block</button>
    
    <div>|</div>
    
    <input type="color" @bind="color" @bind:event="onchange" @bind:after="OnColorChangeAsync" />
</div>
