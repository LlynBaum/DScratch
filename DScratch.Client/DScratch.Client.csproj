<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
        <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.8"/>
    </ItemGroup>

    <ItemGroup>
      <Content Update="Scripts/editor.js">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\DScratch.TreeVisualizers\DScratch.TreeVisualizers.csproj" />
      <ProjectReference Include="..\DScratch\DScratch.csproj" />
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="Components\DocumentEditor.razor" />
      <_ContentIncludedByDefault Remove="Components\EditorMenu.razor" />
      <_ContentIncludedByDefault Remove="Components\RegisterEditor.razor" />
    </ItemGroup>

    <ItemGroup>
      <AdditionalFiles Include="Pages\Editor\Components\DocumentEditor.razor" />
      <AdditionalFiles Include="Pages\Editor\Components\EditorMenu.razor" />
      <AdditionalFiles Include="Pages\Editor\Components\RegisterEditor.razor" />
    </ItemGroup>

    <Target Name="BundleJS" BeforeTargets="Build">
        <Exec Command="npm install" WorkingDirectory="BrowserInteractions/Scripts" />
        <Exec Command="npx esbuild editor.ts --bundle --outfile=../../wwwroot/js/editor.bundle.js" WorkingDirectory="BrowserInteractions/Scripts" />
    </Target>

</Project>
