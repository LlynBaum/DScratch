@rendermode InteractiveWebAssembly

<!-- Floating Toggle Button -->
<button class="debug-toggle-btn @(IsOpen ? "open" : "")" @onclick="TogglePanel" title="Toggle Tree Visualizer">
    @if (IsOpen)
    {
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    }
    else
    {
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
    }
</button>

<!-- Slide-out Drawer Panel -->
<div class="debug-drawer @(IsOpen ? "open" : "")">
    <div class="debug-header">
        <h3>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
            Tree Visualizer
        </h3>
        <div class="header-actions">
            <label class="toggle-switch" title="Log to Console after every event">
                <input type="checkbox" @bind="IsConsoleLogEnabled" />
                <span class="slider"></span>
                <span class="label-text">Log Console</span>
            </label>
        </div>
    </div>

    <div class="debug-content">
        @if (!treeNodes.Any())
        {
            <div class="empty-state">
                <p>No nodes found. Start typing to build the tree.</p>
            </div>
        }
        else
        {
            <div class="tree-list">
                @foreach (var node in treeNodes)
                {
                    <div class="tree-row @(node.IsDeleted ? "deleted" : "")" style="padding-left: @(node.Indent * 20 + 8)px;">
                        <span class="tree-line" style="left: @(node.Indent * 20)px;"></span>
                        
                        <div class="node-badge @node.Type.ToLower()">
                            <span class="node-type">@node.Type.Replace("Node", "")</span>
                            <span class="node-id">@node.Id</span>
                        </div>

                        <div class="node-links">
                            @if (node.OriginId != "null")
                            {
                                <span class="link-badge origin" title="Origin Node ID">
                                    ← @node.OriginId
                                </span>
                            }
                            @if (node.RightOriginId != "null")
                            {
                                <span class="link-badge right-origin" title="Right Origin Node ID">
                                    @node.RightOriginId →
                                </span>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(node.TextContent))
                        {
                            <div class="node-text">
                                <span class="text-val">@node.TextContent</span>
                            </div>
                        }
                        
                        @if (node.IsDeleted)
                        {
                            <span class="deleted-label">Deleted</span>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <div class="debug-footer">
        <span>Total Nodes: @(treeNodes.Count)</span>
    </div>
</div>
