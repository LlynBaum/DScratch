@using DScratch.Client.Components
@using DScratch.Interactions.CommandHandlers
@rendermode InteractiveWebAssembly

<div class="menu">
    <MenubarButton OnClick="@BoldAsync">Bold</MenubarButton>
    <MenubarButton OnClick="@ItalicAsync">Italic</MenubarButton>
    <MenubarButton OnClick="@CodeAsync">Code</MenubarButton>
    
    <MenuDivider />
    
    <MenubarButton OnClick="@BlockquoteAsync">Blockquote</MenubarButton>
    
    <MenuDivider />
    
    <MenubarButton OnClick="@ParagraphAsync">Paragraph</MenubarButton>
    <MenubarButton OnClick="@(async () => await HeadingAsync(BlockNodeType.Heading1))">Heading 1</MenubarButton>
    <MenubarButton OnClick="@(async () => await HeadingAsync(BlockNodeType.Heading2))">Heading 2</MenubarButton>
    <MenubarButton OnClick="@(async () => await HeadingAsync(BlockNodeType.Heading3))">Heading 3</MenubarButton>
    <MenubarButton OnClick="@(async () => await HeadingAsync(BlockNodeType.Heading4))">Heading 4</MenubarButton>
    <MenubarButton OnClick="@(async () => await HeadingAsync(BlockNodeType.Heading5))">Heading 5</MenubarButton>
    <MenubarButton OnClick="@(async () => await HeadingAsync(BlockNodeType.Heading6))">Heading 6</MenubarButton>
    <MenubarButton OnClick="@CodeBlockAsync">Code Block</MenubarButton>
    
    <MenuDivider />
    
    <input type="color" @bind="color" @bind:event="onchange" @bind:after="OnColorChangeAsync" />
</div>