@using Microsoft.AspNetCore.Components.Sections
@rendermode InteractiveWebAssembly

@{
#if DEBUG
<!-- Floating Toggle Button -->
<button class="debug-toggle-btn @(IsOpen ? "open" : "")" @onclick="TogglePanel" title="Toggle Tree Visualizer">
    @if (IsOpen)
    {
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    }
    else
    {
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
    }
</button>

<!-- Slide-out Drawer Panel -->
<div class="debug-drawer @(IsOpen ? "open" : "")">
    <div class="debug-header">
        <h3>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
            Tree Visualizer
        </h3>
        <div class="header-actions">
            <label class="toggle-switch" title="Log to Console after every event">
                <input type="checkbox" @bind="IsConsoleLogEnabled"/>
                <span class="slider"></span>
                <span class="label-text">Log Console</span>
            </label>
        </div>
    </div>
    
    <div class="debug-tabs">
        <button @onclick="@(() => SwitchTab(nameof(DebugTreePanel)))">Tree</button>
        <button @onclick="@(() => SwitchTab(nameof(DebugTransaction)))">Transaction</button>
    </div>

    <div class="debug-content">
        @switch (currentTab)
        {
            case nameof(DebugTreePanel):
                <DebugTreePanel />
                break;
            case nameof(DebugTransaction):
                <DebugTransaction />
                break;
        }
    </div>

    <div class="debug-footer">
        <SectionOutlet SectionName="debug-footer" />
    </div>
</div>
#endif
}
