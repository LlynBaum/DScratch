@page "/"
@using DScratch.Client.Components
@using DScratch.Client.Scripts
@inject KeyPressEventHelper KeyPressEventHelper
@inject IJSRuntime JsRuntime

<HeadContent>
    <link rel="stylesheet" href="@Assets["document-styles.css"]"  />
    <link rel="stylesheet" href="@Assets["document-tokens.css"]"  />
    <script src="@Assets["js/editor.bundle.js"]" type="module"></script>
</HeadContent>

<div id="editor">
    <div class="editor-menu">
        <EditorMenu />
    </div>

    <div class="doc-editor">
        <DocumentEditor />
    </div>
</div>

@code {

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var dotNetRef = DotNetObjectReference.Create(KeyPressEventHelper);
            await JsRuntime.InvokeVoidAsync("editor.initialize", dotNetRef);
        }
    }

}